{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022","dom"],
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowJs": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "strict": true,
  },
  "include": ["src", "vite.config.ts"]
}
